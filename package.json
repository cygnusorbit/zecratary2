{
  "name": "zecratary-monorepo",
  "version": "1.1.19",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build && (ln -sfn apps/web/.next .next 2>/dev/null || true) && (cp server.js apps/web/.next/standalone/server.js 2>/dev/null || true)",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "start": "node server.js",
    "version:bump": "python update_version.py",
    "postinstall": "npm run prisma:generate 2>/dev/null || true",
    "prisma:generate": "npx prisma generate --schema=packages/database/prisma/schema.prisma 2>/dev/null || npx prisma generate 2>/dev/null || true"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "@types/pg": "^8.11.0",
    "autoprefixer": "^10.6.1",
    "mysql2": "^3.24.6",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "postcss": "^8.5.31",
    "prisma": "5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "fsevents@2.3.3": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "fsevents": true
  }
}
