{
  "$schema": "https://v2-11-13.turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "!.next/cache/**",
        "apps/web/.next/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "worker:dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "NEXT_CPU_COUNT",
    "PORT",
    "DATABASE_URL",
    "HOSTNAME",
    "NODE_ENV"
  ]
}